{
  "expo": {
    "name": "greensnow",
    "slug": "greensnow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Log.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Vector-primary.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nixzoe.Greensnow"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Log.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Vector-primary.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "20722b00-b9f5-4e77-947f-520d91d75564"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/20722b00-b9f5-4e77-947f-520d91d75564"
    }
  }
}
